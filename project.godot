; Engine configuration file.
; Proyecto: Espeleología — cueva real (Godot 4.x)
; Abre este archivo con Godot 4.2 o superior: Importar > project.godot

config_version=5

[application]

config/name="Espeleología — La Cueva Real"
run/main_scene="res://escenas/main.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

2d/run_gravity=1400.0

[rendering]

renderer/rendering_method="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.015, 0.02, 0.05, 1)
